{
  "name": "apart-browser",
  "version": "0.5.2",
  "description": "Drive your real, signed-in Chrome from the terminal with Playwright-style scripts",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e6uka/apart.git"
  },
  "homepage": "https://github.com/e6uka/apart#readme",
  "bugs": "https://github.com/e6uka/apart/issues",
  "keywords": [
    "browser",
    "automation",
    "chrome",
    "playwright",
    "cli",
    "agent"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "bin": {
    "apart": "dist/apart.js"
  },
  "files": [
    "dist/apart.js",
    "dist/injected",
    "dist/extension",
    "PRIVACY.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "vitest run",
    "test:e2e": "APART_E2E=1 vitest run test/e2e.test.ts test/headless.test.ts test/features.test.ts test/multi.test.ts",
    "typecheck": "tsc --noEmit",
    "brand": "node scripts/brand.mjs",
    "package:store": "node scripts/build.mjs --store",
    "prepack": "node scripts/build.mjs"
  },
  "dependencies": {
    "dom-accessibility-api": "^0.7.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@fontsource/figtree": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.3.5",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "lucide-static": "^1.60.0",
    "opentype.js": "^2.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  }
}
