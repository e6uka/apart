{
  "name": "apart",
  "version": "0.2.0",
  "private": true,
  "description": "Drive your real, signed-in Chrome from the terminal with Playwright-style scripts",
  "license": "MIT",
  "type": "module",
  "bin": {
    "apart": "dist/apart.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "vitest run",
    "test:e2e": "APART_E2E=1 vitest run test/e2e.test.ts test/headless.test.ts test/features.test.ts",
    "typecheck": "tsc --noEmit",
    "brand": "node scripts/brand.mjs",
    "package:store": "node scripts/build.mjs --store"
  },
  "dependencies": {
    "dom-accessibility-api": "^0.7.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@fontsource/figtree": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.3.5",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "lucide-static": "^1.60.0",
    "opentype.js": "^2.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  }
}
