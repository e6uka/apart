{
  "manifest_version": 3,
  "name": "apart",
  "version": "0.4.0",
  "description": "Lets apart, running on this computer, drive tabs it opens in this browser.",
  "key": "",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "alarms",
    "storage",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "apart",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
